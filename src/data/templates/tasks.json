[
  {
    "id": "task1",
    "description": "Wire the button to the changeValue function",
    "check": {
      "type": "code-contains",
      "pattern": "onClick\\s*=\\s*\\{\\s*changeValue\\s*\\}"
    }
  },
  {
    "id": "task2",
    "description": "Update the state when the button is clicked",
    "check": {
      "type": "code-contains",
      "pattern": "changeValue\\s*=.*=>\\s*\\{?\\s*[^}]*setState\\s*\\("
    }
  },
  {
    "id": "task3",
    "description": "Display \"clicked\" in the message div",
    "check": {
      "type": "code-contains",
      "pattern": "(?=.*setState\\s*\\(\\s*[\"']clicked[\"']\\s*\\))(?=.*\\{message\\})"
    }
  }
]
